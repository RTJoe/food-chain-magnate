{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "declarationMap": false,
    "noEmit": true,
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "customConditions": ["fcm-source"],
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "types": ["node"],
    "jsx": "react-jsx",
    "jsxImportSource": "preact"
  },
  "include": ["packages/*/test/**/*.ts", "packages/ai/src/bench/**/*.ts", "packages/*/scripts/**/*.ts", "vitest.config.ts", "e2e/**/*.ts", "playwright.config.ts"]
}
